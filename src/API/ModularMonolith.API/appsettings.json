{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=modular_monolith;Username=postgres;Password=postgres"
  },

  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest"
  },

  "Keycloak": {
    "Staff": {
      "Authority": "http://localhost:8080/realms/modular-monolith-staff",
      "Audience": "modular-monolith-api",
      "ClientId": "modular-monolith-staff-client",
      "ClientSecret": "your-staff-client-secret"
    },
    "Tenant": {
      "Authority": "http://localhost:8080/realms/modular-monolith-tenants",
      "Audience": "modular-monolith-api",
      "ClientId": "modular-monolith-tenant-client",
      "ClientSecret": "your-tenant-client-secret"
    }
  },

  "Modules": {
    "Customers": {
      "Enabled": true
    },
    "Identity": {
      "Enabled": false
    },
    "Storage": {
      "Enabled": false
    },
    "Notifications": {
      "Enabled": false
    },
    "Orders": {
      "Enabled": false
    },
    "Catalog": {
      "Enabled": false
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  }
}
